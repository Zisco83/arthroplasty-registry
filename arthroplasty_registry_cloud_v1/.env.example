# PostgreSQL connection supplied by your cloud database provider
DATABASE_URL=postgresql+psycopg://registry_user:CHANGE_ME@db.example.com:5432/arthroplasty_registry
# Long random secret, at least 32 characters
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Bootstrap administrator created on first startup if absent
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_NOW
BOOTSTRAP_ADMIN_NAME=Registry Administrator
# Optional browser security settings
COOKIE_SECURE=false
